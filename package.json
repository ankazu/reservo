{
  "name": "reservo",
  "type": "module",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "build": "nuxt build",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:unit": "vitest run test/app test/server/api test/server/services test/server/utils test/shared",
    "typecheck": "nuxt typecheck",
    "typecheck:ui": "vue-tsc --noEmit -p tsconfig.ui.json",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.1",
    "pg": "^8.22.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/pg": "^8.20.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.9"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-x64-gnu": "^0.141.0",
    "@oxc-transform/binding-linux-x64-gnu": "^0.141.0"
  }
}
